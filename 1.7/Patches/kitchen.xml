<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>ferny.progressionkitchen</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<!-- Progression: Kitchen -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ResearchProjectDef[defName="Ferny_FueledStove"]</xpath>
				<value>
					<label Operation="SafeReplace">stove</label>
					<prerequisites Operation="Safe">
						<li Operation="SafeRemove" Compare="InnerText">Ferny_Tables</li>
					</prerequisites>
					<hiddenPrerequisites Operation="Safe">
						<li MayRequire="ferny.progressionfurniture" Operation="SafeAdd" Compare="InnerText">Ferny_Tables</li>
					</hiddenPrerequisites>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>Defs/ResearchProjectDef[defName="Ferny_ElectricStove"]</xpath>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[researchPrerequisites[li="Ferny_ElectricStove"]]</xpath>
				<value>
					<researchPrerequisites Inherit="False" Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText">Electricity</li>
						<li Operation="SafeAdd" Compare="InnerText">Ferny_FueledStove</li>
						<li Operation="SafeRemove" Compare="InnerText">Ferny_ElectricStove</li>
					</researchPrerequisites>
				</value>
			</Operation>
			<!-- Vanilla Helixien Gas Expanded -->
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaexpanded.helixiengas</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.PatchOperationSafeRemove">
						<xpath>Defs/ResearchProjectDef[defName="Ferny_GasPoweredStove"]</xpath>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/ThingDef[researchPrerequisites[li="Ferny_GasPoweredStove"]]</xpath>
						<value>
							<researchPrerequisites Inherit="False" Operation="Safe">
								<li Operation="SafeAdd" Compare="InnerText">Ferny_FueledStove</li>
								<li Operation="SafeRemove" Compare="InnerText">Ferny_GasPoweredStove</li>
								<li Operation="SafeAdd" Compare="InnerText">VHGE_GasExtraction</li>
							</researchPrerequisites>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
