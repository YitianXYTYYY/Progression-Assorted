<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>ferny.progressionattire</li>
			<li>cruesoe.progressionlessattire</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<!-- Core -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ResearchProjectDef[defName="PlateArmor"]</xpath>
				<value>
					<prerequisites Operation="Safe">
						<li Operation="SafeRemove" Compare="InnerText">LemonSkin_RusticClothing</li>
					</prerequisites>
					<hiddenPrerequisites Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText">LemonSkin_RusticClothing</li>
					</hiddenPrerequisites>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="Apparel_SimpleHelmet"]</xpath>
				<value>
					<recipeMaker Operation="Safe">
						<researchPrerequisites Operation="Safe">
							<li Operation="SafeRemove" Compare="InnerText">ComplexClothing</li>
							<li Operation="SafeAdd" Compare="InnerText">Machining</li>
						</researchPrerequisites>
					</recipeMaker>
				</value>
			</Operation>
			<!-- Biotech -->
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>ludeon.rimworld.biotech</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/ResearchProjectDef[defName="LemonSkin_GasMask"]</xpath>
						<value>
							<prerequisites Operation="Safe">
								<li Operation="SafeRemove" Compare="InnerText">Machining</li>
								<li Operation="SafeAdd" Compare="InnerText">ToxGas</li>
							</prerequisites>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
			<!-- Progression: Attire -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ResearchProjectDef[defName="LemonSkin_ElectricTailoringBench"]</xpath>
				<value>
					<prerequisites Operation="Safe">
						<li Operation="SafeRemove" Compare="InnerText">Electricity</li>
					</prerequisites>
					<hiddenPrerequisites Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText">Electricity</li>
					</hiddenPrerequisites>
				</value>
			</Operation>
			<!-- Vanilla Armour Expanded -->
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaexpanded.varme</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/ResearchProjectDef[defName="VAE_LeatherTanning"]</xpath>
						<value>
							<prerequisites Operation="Safe">
								<li Operation="SafeRemove" Compare="InnerText">ComplexClothing</li>
								<li Operation="SafeAdd" Compare="InnerText">LemonSkin_RusticClothing</li>
							</prerequisites>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/ResearchProjectDef[defName="VAE_MilitaryClothing"]</xpath>
						<value>
							<prerequisites Operation="Safe">
								<li Operation="SafeRemove" Compare="InnerText">VAE_LeatherTanning</li>
								<li Operation="SafeAdd" Compare="InnerText">ComplexClothing</li>
							</prerequisites>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
