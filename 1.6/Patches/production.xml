<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Progression: Production -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>ferny.progressionproduction</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.SetScope">
				<xpath>Defs/ResearchProjectDef[defName="DrugProduction"]</xpath>
				<apply>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>ResearchProjectDef</xpath>
						<value>
							<techLevel Operation="SafeReplace">Medieval</techLevel>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.FindMod">
						<mods>
							<li>ferny.progressionfurniture</li>
						</mods>
						<packageId>true</packageId>
						<caseTrue>
							<Operation Class="XmlExtensions.HybridPatch">
								<xpath>ResearchProjectDef</xpath>
								<value>
									<prerequisites Operation="Safe">
										<li Operation="SafeRemove" Compare="InnerText">Ferny_Tables</li>
									</prerequisites>
									<hiddenPrerequisites Operation="Safe">
										<li Operation="SafeAdd" Compare="InnerText">Ferny_Tables</li>
									</hiddenPrerequisites>
								</value>
							</Operation>
						</caseTrue>
					</Operation>
				</apply>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaexpanded.helixiengas</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/ResearchProjectDef[defName="Ferny_GasPoweredRefinery"]</xpath>
						<value>
							<prerequisites Operation="Safe">
								<li Operation="SafeRemove" Compare="InnerText">BiofuelRefining</li>
							</prerequisites>
							<hiddenPrerequisites Operation="Safe">
								<li Operation="SafeAdd" Compare="InnerText">BiofuelRefining</li>
							</hiddenPrerequisites>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
